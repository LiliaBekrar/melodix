# ============================================================
# Variables d'environnement — copiez ce fichier en .env.local
# ============================================================

# Votre Client ID Spotify (obtenu sur https://developer.spotify.com/dashboard)
VITE_SPOTIFY_CLIENT_ID=votre_client_id_ici

# Nom exact du repo GitHub Pages
# Exemple : spotify-assistant
VITE_REPOSITORY_NAME=spotify-assistant

# true = déploiement sur https://username.github.io/nom-du-repo/
# false = domaine racine / custom domain
VITE_GITHUB_PAGES_PROJECT=true

# URI de redirection après connexion Spotify
# Développement local
VITE_REDIRECT_URI=http://localhost:5173/callback

# Production GitHub Pages
# Remplacez username et le repo si besoin
# VITE_REDIRECT_URI=https://username.github.io/spotify-assistant/callback

# Variante locale si Vite ouvre sur 127.0.0.1 au lieu de localhost
# VITE_REDIRECT_URI=http://127.0.0.1:5173/callback
